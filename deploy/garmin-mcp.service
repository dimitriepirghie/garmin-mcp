[Unit]
Description=Garmin Connect MCP server (Streamable HTTP, bearer auth)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=garmin-mcp
Group=garmin-mcp
WorkingDirectory=/opt/garmin-mcp

# MCP_BEARER_TOKEN=... (root-owned, mode 600; systemd reads it before dropping to User=)
EnvironmentFile=/etc/garmin-mcp.env
Environment=GARMIN_TOKEN_DIR=/var/lib/garmin-mcp/tokens
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8000
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/garmin-mcp/.venv/bin/python /opt/garmin-mcp/garmin_mcp.py --http
Restart=on-failure
RestartSec=10

# /var/lib/garmin-mcp, writable by the service (garminconnect rewrites the
# token file when it refreshes the session)
StateDirectory=garmin-mcp
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryMax=400M

[Install]
WantedBy=multi-user.target
